# gm plugkit runtime
.agentplug-kv/
.gm/pw-sock-*/
.gm/exec-spool/
# gm-plugkit occasionally registers/reboots the watcher from a cwd other
# than the repo root (e.g. mid-session while a shell's cwd was temporarily
# test/hardware/) -- WITNESSED this session, creates a stray nested .gm/
# tree wherever that cwd was. **/.gm/ (not root-anchored) catches any such
# subdirectory, not just the real repo-root .gm/ this file's own patterns
# above assume.
**/.gm/exec-spool/
**/.gm/pw-sock-*/
.gm/witness/
.gm/*.db
.gm/*.db-*
.gm/last-dispatch-ts
.gm/last-instruction-ts
.gm/next-step.md
.gm/turn-state.json
.gm/residual-check-fired
.gm/.gm-continue-count
.gm/last-prompt.txt
.gm/instructions/
.gm/memories/*.tmp-*
.gm/disciplines/codeinsight-manifest/
.gm/disciplines/codeinsight-vec/
.gm/_prompt.json
.gm/.instructions-shipped-manifest.json

# build artifacts
build/
*.o
*.so
*.exe
*.lv2/*.so
image/*.img
kernel/*-build/
node_modules/

# cross-compile output
out/
dist/

# scratch dir for downloaded CI artifacts during manual deploy/debug
tmp/

# host-side netboot serving scratch (artifacts + WSL adhoc scripts)
.netboot-stage/
.netboot-serve/
.netboot-serve.new.*/
.netboot-serve.log
.netboot-serve.err.log
.netboot-update-sha
.netboot-update-work/

# MinGW/MSYS2 subprocess crash dumps (host-tooling artifact, not repo state)
*.stackdump
.image-flash-work/
